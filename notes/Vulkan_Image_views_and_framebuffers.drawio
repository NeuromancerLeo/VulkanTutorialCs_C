                <mxCell id="63" value="&lt;h1 style=&quot;margin-top: 0px; line-height: 70%;&quot;&gt;&lt;font style=&quot;font-size: 20px; line-height: 70%;&quot; face=&quot;Xiaolai Regular&quot;&gt;渲染通道 (&lt;/font&gt;&lt;font face=&quot;Xiaolai Regular&quot; style=&quot;font-size: 20px; line-height: 70%;&quot;&gt;VkRenderPass&lt;/font&gt;&lt;font style=&quot;font-size: 20px; line-height: 70%;&quot; face=&quot;Xiaolai Regular&quot;&gt;)&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 70%;&quot;&gt;&lt;font style=&quot;font-size: 15px; font-weight: normal; line-height: 70%;&quot; face=&quot;Xiaolai Regular&quot;&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;通过多个 VkAttachmentDescription 来描述&lt;/span&gt;关于图像 (s)&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-size: 15px; font-weight: normal; font-family: &amp;quot;Xiaolai Regular&amp;quot;; background-color: transparent; line-height: 70%;&quot;&gt;的定义信息和其&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-size: 15px; font-weight: normal; font-family: &amp;quot;Xiaolai Regular&amp;quot;; background-color: transparent;&quot;&gt;一系列&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: &amp;quot;Xiaolai Regular&amp;quot;; font-size: 15px; font-weight: normal;&quot;&gt;&amp;nbsp;读 \ 写 时的操作信息，其意义是提前告知 GPU 驱动待进行真正渲染时&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63); font-family: &amp;quot;Xiaolai Regular&amp;quot;; font-size: 15px; font-weight: normal;&quot;&gt;具体使用的图像 (s) 的定义以及&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63); font-family: &amp;quot;Xiaolai Regular&amp;quot;; font-size: 15px; font-weight: normal;&quot;&gt;我们会如何对待它们&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: &amp;quot;Xiaolai Regular&amp;quot;; font-size: 15px; font-weight: normal; color: rgb(63, 63, 63);&quot;&gt;，&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: &amp;quot;Xiaolai Regular&amp;quot;; font-size: 15px; font-weight: normal; color: rgb(63, 63, 63);&quot;&gt;从而&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: &amp;quot;Xiaolai Regular&amp;quot;; font-size: 15px; font-weight: normal; color: rgb(63, 63, 63);&quot;&gt;使&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: &amp;quot;Xiaolai Regular&amp;quot;; font-size: 15px; font-weight: normal; color: rgb(63, 63, 63);&quot;&gt;驱动&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: &amp;quot;Xiaolai Regular&amp;quot;; font-size: 15px; font-weight: normal; color: rgb(63, 63, 63);&quot;&gt;不需要进行任何猜测，能够根据这些描述进行内存管理上的优化.&lt;/span&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="745" y="103" width="340" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="65" value="&lt;font face=&quot;Xiaolai Regular&quot;&gt;// 创建 &lt;/font&gt;&lt;font style=&quot;color: rgb(153, 51, 255);&quot; face=&quot;Helvetica&quot;&gt;VkFramebuffer &lt;/font&gt;&lt;font face=&quot;Xiaolai Regular&quot;&gt;时需要指定一个对应的 &lt;/font&gt;&lt;font style=&quot;color: rgb(0, 204, 0);&quot; face=&quot;Helvetica&quot;&gt;VkRenderPass&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: &amp;quot;Xiaolai Regular&amp;quot;;&quot;&gt;来做&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Xiaolai Regular&amp;quot;; background-color: transparent;&quot;&gt;匹配，做创建时验证和内存优化用&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="300" y="213" width="150" height="40" as="geometry"/>
