<mxfile host="65bd71144e">
    <diagram id="AGm-llFct5cwbNSXjPkK" name="Page-1">
        <mxGraphModel dx="1733" dy="719" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="12" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;描述符集（Descriptor set）录制模型：&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;// Bind Pipeline&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;// Bind &lt;b&gt;general/global&lt;/b&gt;&amp;nbsp;descriptor set - at set #0&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;// &lt;i&gt;For each&lt;/i&gt; material in Materials&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;// Bind &lt;b&gt;material&lt;/b&gt; descriptor set - at set #1&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;// &lt;i&gt;For each&lt;/i&gt;&amp;nbsp;drawItem that uses material&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-size: 20px; background-color: transparent;&quot;&gt;// Bind drawItem vertex buffer、index buffer .etc&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;// Bind drawItem descriptor set - at set #2&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;// Draw call&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="40" y="40" width="500" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="&lt;span style=&quot;font-size: 17px;&quot;&gt;// 可以看到描述符的绑定是以“&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-size: 17px;&quot;&gt;集&lt;/span&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;” 为单位的，这可以&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-size: 17px;&quot;&gt;使得代码在逻辑上较为清晰，也能够让驱动有优化的空间&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="540" y="110" width="430" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;描述符集布局（Descriptor set layout）的定义：&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;描述符集布局（VkDescriptorSetLayout）用于在开发者创建管线时定义其期望的描述符的集的布局，就像指定要用于哪个 RenderPass 的 subpass 那样。&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="40" y="430" width="480" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;描述符集（Descriptor set）对象的创建：&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;创建一个描述符集对象需要创建对应描述符池并从中分配。&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="580" y="190" width="480" height="170" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>